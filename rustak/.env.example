# Rustrak server configuration
# Docs: https://rustrak.github.io/rustrak/getting-started/installation
# Copy this file to .env and fill in the values, then `docker compose up -d`.

### Database ###
# Postgres is NOT started by this compose file — point these at your
# already-running instance. If it's another container on this host,
# "host.docker.internal" (enabled via extra_hosts below) usually works;
# otherwise use its LAN IP/hostname.
# Named RUSTAK_DB_* (not POSTGRES_*) to avoid clashing with any POSTGRES_USER/
# POSTGRES_PASSWORD you may already have exported in your shell (e.g. for psql).
RUSTAK_DB_HOST=host.docker.internal
RUSTAK_DB_PORT=5432
RUSTAK_DB_USER=rustak
RUSTAK_DB_PASSWORD=changeme
RUSTAK_DB_NAME=rustak

# Pool sizing (optional)
#DATABASE_MAX_CONNECTIONS=10
#DATABASE_MIN_CONNECTIONS=1

### Server ###
# Host port the dashboard/API is published on
SERVER_PORT=8080

# Host port the standalone UI is published on
UI_PORT=8121

# trace | debug | info | warn | error
RUST_LOG=info

# Required. Generate with: openssl rand -hex 32
SESSION_SECRET_KEY=

# Set to true when running behind a reverse proxy that terminates HTTPS
# (e.g. angie), so session cookies are marked secure.
SSL_PROXY=true

# Public URL SDKs use to send events, and that the dashboard is reached at.
# Must NOT be localhost in production.
PUBLIC_URL=https://rustak.xtweb.eu

# Creates an initial admin account on first boot, format: email:password
# Only takes effect if no users exist yet. Remove/blank out after first run.
CREATE_SUPERUSER=admin@example.com:changeme

### Optional ###
# IANA timezone used for log timestamps
#RUSTRAK_LOG_TIMEZONE=UTC

# Anonymous usage telemetry: on | off
#RUSTRAK_TELEMETRY=on

# Base URL used to build issue links in outgoing notifications
#DASHBOARD_URL=https://rustak.xtweb.eu

# Global / per-project event rate limits
#MAX_EVENTS_PER_MINUTE=1000
#MAX_EVENTS_PER_HOUR=10000
#MAX_EVENTS_PER_PROJECT_PER_MINUTE=500
#MAX_EVENTS_PER_PROJECT_PER_HOUR=5000

# SMTP (for alert emails)
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=alerts@rustak.xtweb.eu
