server {
    listen 80;
    listen [::]:80;
    #server_name *.xtweb.eu;
    server_name ~^(tms|sigvi)\.xtweb\.eu$;

    include conf.d/system/block.php.conf;
    include conf.d/system/block.env.conf;

    # if ($allow = no) {
    #     return 444;
    # }

    # if ($server_protocol ~* "HTTP/1.0") {
    #     return 444;
    # }

    location / {
        include conf.d/system/proxy_params;
        proxy_headers_hash_max_size 512;
        proxy_headers_hash_bucket_size 128;
        proxy_pass http://192.168.0.9:8000;
    }

#    location /react/ {
#        proxy_headers_hash_max_size 512;
#        proxy_headers_hash_bucket_size 128;
#        include proxy_params;
#        proxy_pass http://127.0.0.1:3000;
#    }


location /ws/ {
    proxy_pass          http://127.0.0.1:7388;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

    proxy_set_header    Host                $host;
    proxy_set_header    X-Real-IP           $remote_addr;
    proxy_set_header    X-Forwarded-For     $proxy_add_x_forwarded_for;

}

}

